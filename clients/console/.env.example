# Base URL of the dante api-gateway. In dev this is proxied via vite (/api -> gateway),
# so you can leave it as the default localhost. In prod set it to the gateway origin.
VITE_API_BASE_URL=http://localhost:8080

# Solana cluster the console renders balances and wallet actions against.
# One of: devnet | mainnet-beta | testnet, or a full RPC URL.
VITE_SOLANA_CLUSTER=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# SPL mint the platform bills in. Devnet USDC by default; swap for the mainnet
# USDC mint (EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v) when going live.
VITE_USDC_MINT=Gh9ZwEmdLJ8DscKNTkTqPbNwLNNBjuSzaG9Vp2KGtKJr
VITE_USDC_DECIMALS=6

# Platform deposit wallet: where renters send USDC to top up their balance.
# This must match the billing-payment-service custody/treasury address.
VITE_PLATFORM_DEPOSIT_ADDRESS=
