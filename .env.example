# DanteGPU Platform - Environment Configuration
# Copy this file to .env and fill in the values

# ============================================================================
# APPLICATION
# ============================================================================
NODE_ENV=development
APP_NAME=DanteGPU
APP_VERSION=1.0.0
APP_PORT=8080
APP_HOST=0.0.0.0
LOG_LEVEL=info

# ============================================================================
# DATABASE - PostgreSQL
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dante_core
DB_USER=dante_user
DB_PASSWORD=your_secure_password_here
DB_SSL_MODE=disable
DB_MAX_CONNECTIONS=100
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# Database URLs for different services
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
AUTH_DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/dante_auth
BILLING_DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/dante_billing
REGISTRY_DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/dante_registry
SCHEDULER_DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/dante_scheduler

# ============================================================================
# REDIS
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# Redis for different purposes
REDIS_CACHE_DB=0
REDIS_SESSION_DB=1
REDIS_RATE_LIMIT_DB=2
REDIS_QUEUE_DB=3

# ============================================================================
# NATS
# ============================================================================
NATS_URL=nats://localhost:4222
NATS_CLUSTER_ID=dantegpu-cluster
NATS_CLIENT_ID=dantegpu-client

# NATS Authentication
NATS_SYSTEM_USER=admin
NATS_SYSTEM_PASSWORD=your_nats_system_password_here
NATS_API_GATEWAY_USER=api_gateway
NATS_API_GATEWAY_PASSWORD=your_nats_api_password_here
NATS_PROVIDER_USER=provider_daemon
NATS_PROVIDER_PASSWORD=your_nats_provider_password_here
NATS_SCHEDULER_USER=scheduler
NATS_SCHEDULER_PASSWORD=your_nats_scheduler_password_here
NATS_BILLING_USER=billing
NATS_BILLING_PASSWORD=your_nats_billing_password_here
NATS_MONITORING_USER=monitoring
NATS_MONITORING_PASSWORD=your_nats_monitoring_password_here

# NATS Cluster
NATS_CLUSTER_USER=cluster_user
NATS_CLUSTER_PASSWORD=your_nats_cluster_password_here

# ============================================================================
# CONSUL
# ============================================================================
CONSUL_HTTP_ADDR=localhost:8500
CONSUL_DATACENTER=dantegpu-dc1
CONSUL_MASTER_TOKEN=your_consul_master_token_here
CONSUL_AGENT_TOKEN=your_consul_agent_token_here
CONSUL_ENCRYPT_KEY=your_consul_encrypt_key_here

# ============================================================================
# MINIO (S3-compatible storage)
# ============================================================================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_root_password_here
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# MinIO Service Accounts
JOB_SERVICE_ACCESS_KEY=job_service
JOB_SERVICE_SECRET_KEY=your_job_service_secret_here
STORAGE_SERVICE_ACCESS_KEY=storage_service
STORAGE_SERVICE_SECRET_KEY=your_storage_service_secret_here
BACKUP_SERVICE_ACCESS_KEY=backup_service
BACKUP_SERVICE_SECRET_KEY=your_backup_service_secret_here

# ============================================================================
# SOLANA BLOCKCHAIN
# ============================================================================
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
SOLANA_NETWORK=devnet
SOLANA_COMMITMENT=confirmed

# Settlement token (USDC)
USDC_TOKEN_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
USDC_TOKEN_DECIMALS=6

# Platform Wallet (for fee collection)
PLATFORM_WALLET_ADDRESS=your_platform_wallet_address_here
PLATFORM_WALLET_PRIVATE_KEY=your_platform_wallet_private_key_here

# Transaction Settings
SOLANA_MAX_RETRIES=3
SOLANA_CONFIRMATION_TIMEOUT=60000
SOLANA_SKIP_PREFLIGHT=false

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

# ============================================================================
# ENCRYPTION
# ============================================================================
ENCRYPTION_KEY=your_encryption_key_here_32_chars
ENCRYPTION_ALGORITHM=aes-256-gcm
WALLET_ENCRYPTION_KEY=your_wallet_encryption_key_here

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# API Key Rate Limits
API_KEY_RATE_LIMIT_PER_MINUTE=60
API_KEY_RATE_LIMIT_PER_HOUR=1000
API_KEY_RATE_LIMIT_PER_DAY=10000

# ============================================================================
# CORS
# ============================================================================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# ============================================================================
# PRICING & BILLING
# ============================================================================
PLATFORM_FEE_PERCENTAGE=5.0
MIN_RENTAL_DURATION_MINUTES=60
MAX_RENTAL_DURATION_MINUTES=43200
BILLING_INTERVAL_MINUTES=1
MIN_DEPOSIT_AMOUNT=10
MIN_WITHDRAWAL_AMOUNT=5

# ============================================================================
# EMAIL (for notifications)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password_here
EMAIL_FROM=noreply@dantegpu.com
EMAIL_FROM_NAME=DanteGPU Platform

# ============================================================================
# SMS (for 2FA)
# ============================================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# MONITORING - Prometheus
# ============================================================================
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_RETENTION_TIME=15d

# ============================================================================
# MONITORING - Grafana
# ============================================================================
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here
GRAFANA_SECRET_KEY=your_grafana_secret_key_here

# ============================================================================
# LOGGING - Loki
# ============================================================================
LOKI_URL=http://localhost:3100
LOKI_RETENTION_PERIOD=30d

# ============================================================================
# TRACING - Jaeger
# ============================================================================
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLER_TYPE=probabilistic
JAEGER_SAMPLER_PARAM=0.1

# ============================================================================
# FRONTEND URLs
# ============================================================================
FRONTEND_URL=http://localhost:3000
PROVIDER_DASHBOARD_URL=http://localhost:3001
ADMIN_DASHBOARD_URL=http://localhost:3002

# ============================================================================
# WEBHOOK URLs
# ============================================================================
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_TIMEOUT=30000

# ============================================================================
# FILE UPLOAD
# ============================================================================
MAX_FILE_SIZE=1073741824
ALLOWED_FILE_TYPES=.tar.gz,.zip,.h5,.pt,.pth,.onnx,.pb,.tflite
UPLOAD_TIMEOUT=300000

# ============================================================================
# SESSION
# ============================================================================
SESSION_SECRET=your_session_secret_here_min_32_chars
SESSION_MAX_AGE=86400000
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ============================================================================
# SECURITY
# ============================================================================
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true

# Account Lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_REGISTRATION=true
ENABLE_2FA=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_PROVIDER_REGISTRATION=true
ENABLE_MAINTENANCE_MODE=false
ENABLE_DEBUG_MODE=false

# ============================================================================
# DOCKER
# ============================================================================
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_REGISTRY=docker.io
DOCKER_REGISTRY_USER=your_docker_user
DOCKER_REGISTRY_PASSWORD=your_docker_password

# ============================================================================
# KUBERNETES (if using K8s)
# ============================================================================
K8S_NAMESPACE=dantegpu
K8S_CONFIG_PATH=~/.kube/config
K8S_IN_CLUSTER=false

# ============================================================================
# SENTRY (Error Tracking)
# ============================================================================
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# ANALYTICS
# ============================================================================
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
MIXPANEL_TOKEN=your_mixpanel_token_here

# ============================================================================
# BACKUP
# ============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=dantegpu-backups

# ============================================================================
# DEVELOPMENT
# ============================================================================
DEV_MODE=true
HOT_RELOAD=true
MOCK_BLOCKCHAIN=false
MOCK_PAYMENTS=false
SKIP_EMAIL_VERIFICATION=false

